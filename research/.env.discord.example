# Copy these values into your shell environment. Never commit the bot token.
DISCORD_BOT_TOKEN=replace_with_bot_token
DISCORD_GUILD_ID=replace_with_server_id
DISCORD_CHANNEL_ID=replace_with_review_channel_id

# Optional comma-separated Discord user IDs. If empty, members with
# Manage Server permission can use the review controls.
DISCORD_REVIEWER_IDS=replace_with_your_user_id
